---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { businessConfig } from '../business-config';
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Business Website | Professional Solutions"
			description="Discover professional business solutions and services designed to help your business grow."
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<style>
			:global(*) {
				box-sizing: border-box;
			}

			:global(html) {
				scroll-behavior: smooth;
			}

			:global(body) {
				margin: 0;
				font-family: Arial, Helvetica, sans-serif;
				color: #243247;
				background: #ffffff;
			}

			.hero {
				background: #f1f5f9;
				padding: 100px 8%;
				display: grid;
				grid-template-columns: 1.1fr 0.9fr;
				gap: 50px;
				align-items: center;
			}

			.eyebrow {
				color: #315d91;
				font-size: 13px;
				font-weight: 700;
				letter-spacing: 2px;
				text-transform: uppercase;
			}

			h1 {
				color: #172b46;
				font-size: clamp(40px, 5vw, 66px);
				line-height: 1.1;
				letter-spacing: -2px;
				margin: 20px 0;
			}

			.hero p {
				color: #657286;
				font-size: 18px;
				line-height: 1.8;
				max-width: 540px;
			}

			.button {
				display: inline-block;
				padding: 15px 26px;
				margin-top: 20px;
				border-radius: 5px;
				background: #244b79;
				color: #ffffff;
				text-decoration: none;
				font-weight: 700;
			}

			.button:hover {
				background: #173658;
			}

			.hero-visual {
				min-height: 360px;
				border-radius: 12px;
				background: linear-gradient(135deg, #244b79, #9aafc8);
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 35px;
				text-align: center;
				color: white;
			}

			.hero-visual h2 {
				color: white;
				font-size: 32px;
				line-height: 1.4;
			}

			.section {
				padding: 85px 8%;
			}

			.section-heading {
				max-width: 650px;
				margin: 0 auto 45px;
				text-align: center;
			}

			.section-heading h2,
			.about h2,
			.contact h2 {
				font-size: 36px;
				color: #172b46;
				margin: 15px 0;
			}

			.section-heading p,
			.card p {
				color: #657286;
				line-height: 1.8;
			}

			.cards {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 25px;
			}

			.card {
				padding: 30px;
				border: 1px solid #e4e9ef;
				border-radius: 8px;
				background: #ffffff;
			}

			.card h3 {
				color: #244b79;
				font-size: 21px;
			}

			.card p {
				margin-bottom: 0;
			}

			.about {
				background: #f4f6f9;
				text-align: center;
			}

			.about p {
				max-width: 720px;
				margin: 20px auto;
				color: #657286;
				line-height: 1.9;
			}

			.contact {
				background: #172b46;
				text-align: center;
			}

			.contact h2 {
				color: #ffffff;
			}

			.contact p {
				color: #d5dfeb;
				line-height: 1.8;
			}

			.contact .button {
				background: #ffffff;
				color: #172b46;
			}

			.contact .button:hover {
				background: #e5eaf0;
			}

			@media (max-width: 750px) {
				.hero {
					grid-template-columns: 1fr;
					padding: 70px 7%;
				}

				.hero-visual {
					min-height: 240px;
				}

				.cards {
					grid-template-columns: 1fr;
				}

				.section {
					padding: 65px 7%;
				}

				.section-heading h2,
				.about h2,
				.contact h2 {
					font-size: 30px;
				}
			}
		</style>
	</head>

	<body>
		<Header />

		<main>
			<section class="hero">
				<div>
					<span class="eyebrow">Welcome to our company</span>

					<h1>Building better solutions for your business.</h1>

					<p>
						We help businesses move forward through reliable
						services, thoughtful solutions and a commitment
						to quality.
					</p>

					<a class="button" href="#contact">Get in Touch</a>
				</div>

				<div class="hero-visual">
					<h2>Your Business. Your Vision. Our Commitment.</h2>
				</div>
			</section>

			<section class="section">
				<div class="section-heading">
					<span class="eyebrow">What We Do</span>
					<h2>Our Services</h2>
					<p>
						Discover how our expertise and approach can help
						your business achieve its goals.
					</p>
				</div>

				<div class="cards">
					<div class="card">
						<h3>Our Services</h3>
						<p>
							Professional solutions designed around your
							business requirements.
						</p>
					</div>

					<div class="card">
						<h3>Our Expertise</h3>
						<p>
							Knowledge, experience and attention to detail
							in everything we do.
						</p>
					</div>

					<div class="card">
						<h3>Our Commitment</h3>
						<p>
							Building lasting relationships through quality
							and dependable service.
						</p>
					</div>
				</div>
			</section>

			<section class="section about">
				<span class="eyebrow">Who We Are</span>
				<h2>About Our Company</h2>
				<p>
					We believe every successful business starts with a
					clear vision and a strong commitment to its customers.
					Our goal is to deliver meaningful solutions and build
					relationships that last.
				</p>
				<a class="button" href="#contact">Learn More</a>
			</section>

			<section class="section contact" id="contact">
				<h2>Let's Work Together</h2>
				<p>
					Have a project or an idea? We'd love to hear from you.
				</p>
				<a class="button" href="mailto:hello@example.com">
					Contact Us
				</a>
			</section>
		</main>

		<Footer />
	</body>
</html>
